# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).
# Os valores ficam no painel do Supabase (Project Settings → API Keys). NUNCA faça commit dos valores reais.

# Mesmo projeto Supabase do sistema "relatorio" (login compartilhado)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente no servidor (Vercel). Usada no cálculo, no modo TV e na gestão de logins.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Token que o robô do Klingo usa para pedir o recálculo (gere um valor aleatório longo).
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRACKCO_RECALC_TOKEN=troque-por-um-valor-aleatorio

# Domínio fictício dos logins (o mesmo do relatorio: usuario@acesso.iobaoftalmo.com.br)
LOGIN_DOMINIO=acesso.iobaoftalmo.com.br
